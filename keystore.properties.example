# Copy to keystore.properties (gitignored) to sign release builds. Keep the keystore itself outside
# the repository and back it up: losing it means you can never update the app under the same key.
# Create one with:
#   keytool -genkeypair -v -keystore /path/to/devswitch-release.jks -alias devswitch \
#           -keyalg RSA -keysize 4096 -validity 10000
storeFile=/absolute/path/to/devswitch-release.jks
storePassword=change-me
keyAlias=devswitch
keyPassword=change-me
